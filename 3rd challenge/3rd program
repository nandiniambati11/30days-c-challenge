// SMART CART
#include<stdio.h>
int main(){
float amount,delivery_distance,discount_rate,discount_amount,net_amount,delivery_charge,total_bill;
int customer_type;
printf("Enter total shopping amount:\n");
scanf("%f",&amount);
printf("Enter customer type (1-Student, 2-Regular):\n");
scanf("%d",&customer_type);
printf("Enter delivery distance in km:\n");
scanf("%f",&delivery_distance);
if(customer_type==1&&amount>=2000){
discount_rate=15;
}
else if(customer_type==1&&amount<2000){
discount_rate=10;
}
else if(customer_type==2&&amount>=3000){
discount_rate=8;
}
else{
discount_rate=0;
}
discount_amount=amount*discount_rate/100;
net_amount=amount-discount_amount;
if(delivery_distance<=5){
delivery_charge=40;
}
else if(delivery_distance>5&&delivery_distance<=15){
delivery_charge=70;
}
else{
delivery_charge=100;
}
total_bill=net_amount+delivery_charge;
printf("SMART CART BILL\n");
printf("Purchase Amount : Rs. %.2f\n",amount);
printf("Discount Rate : %.2f%%\n",discount_rate);
printf("Discount Amount : Rs. %.2f\n",discount_amount);
printf("Amount After Discount : Rs. %.2f\n",net_amount);
printf("Delivery Charges : Rs. %.2f\n",delivery_charge);
printf("Final Payable Amount : Rs. %.2f\n",total_bill);
return 0;
}
